#2389 Longest Subsequence with Limited Size
#solved using binary search
class Solution {
public:
    vector<int> answerQueries(vector<int>& nums, vector<int>& queries) {
        sort(nums.begin(), nums.end());

        for (int i = 1; i < nums.size(); i++) {
            nums[i] += nums[i - 1];
        }

        vector<int> ans;

        for (int q : queries) {
            int count = 0;
            int sum = 0;

            for (int i = 0; i < nums.size(); i++) {
                if (nums[i] <= q) {
                    count++;
                } else {
                    break;
                }
            }

            ans.push_back(count);
        }

        return ans;
    }
};
